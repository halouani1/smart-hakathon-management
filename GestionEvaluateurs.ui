  <property name="styleSheet">
   <string notr="true">
QMainWindow{background:#F5F7FB;}
QWidget{font-family:"Segoe UI";color:#18243A;}
#sidebar{background:#07133A;}
#brand{color:white;font-size:24px;font-weight:700;}
#brand2{color:#C9D3EA;font-size:20px;font-weight:600;}
#sectionTitle{color:#AAB8D4;font-size:12px;font-weight:600;}
#navButton{background:transparent;border:0;border-radius:8px;color:#D9E2F4;text-align:left;padding:12px 16px;font-size:14px;}
#navButton:hover{background:#10224F;}
#navActive{background:#1F65D6;border:0;border-radius:8px;color:white;text-align:left;padding:12px 16px;font-size:14px;font-weight:700;}
#logout{background:#D64545;color:white;border:0;border-radius:7px;padding:11px 16px;font-weight:600;}
#pageTitle{font-size:30px;font-weight:750;color:#101C36;}
#subtitle{color:#6C7890;font-size:13px;}
#cardForm,#cardTableExtra{background:white;border:1px solid #E4E8F0;border-radius:12px;}
#cardTotal{background:#EEF5FF;border:1px solid #D9E8FF;border-radius:12px;}
#cardInactive{background:#FFF1F1;border:1px solid #FFD8D8;border-radius:12px;}
#metricTotalLabel,#metricActiveLabel,#metricInactiveLabel,#metricScoreLabel{color:#68758B;font-size:13px;font-weight:600;}
#metricTotal,#metricActive,#metricScore{font-size:30px;font-weight:800;color:#12356B;}
#metricInactive{font-size:30px;font-weight:800;color:#C43C3C;}
#sectionHeader{font-size:17px;font-weight:750;color:#15213B;}
#fieldLabel{font-size:12px;font-weight:700;color:#59677F;}
QLineEdit,QComboBox{background:white;border:1px solid #D8DEE9;border-radius:7px;padding:9px 11px;min-height:20px;color:#17233B;}
QLineEdit:focus,QComboBox:focus{border:1px solid #1F65D6;}
#primary{background:#1F65D6;color:white;border:0;border-radius:7px;padding:10px 18px;font-weight:700;}
#secondary{background:#EEF1F6;color:#39465C;border:1px solid #D8DEE9;border-radius:7px;padding:10px 18px;font-weight:600;}
#danger{background:#D64545;color:white;border:0;border-radius:7px;padding:8px 13px;font-weight:600;}
#edit{background:#EAF3FF;color:#1F65D6;border:1px solid #CFE2FF;border-radius:7px;padding:8px 13px;font-weight:600;}
#tableSearch{background:white;border:1px solid #D8DEE9;border-radius:7px;padding:9px 12px;}
QTableWidget{background:white;border:1px solid #E1E6EF;border-radius:9px;gridline-color:#EDF0F5;selection-background-color:#EAF3FF;selection-color:#15213B;}
QHeaderView::section{background:#1F437A;color:white;border:0;border-right:1px solid #31568F;padding:10px;font-size:12px;font-weight:700;}
#statusActive{background:#E7F7EF;color:#16804E;border-radius:10px;padding:4px 9px;font-weight:700;}
#statusInactive{background:#FCEAEA;color:#C43C3C;border-radius:10px;padding:4px 9px;font-weight:700;}
#footer{color:#8490A4;font-size:11px;}
QPushButton{outline:0;}
